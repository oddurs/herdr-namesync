---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { url } from '../lib/url';

interface Props {
  title: string;
  description: string;
  section?: 'home' | 'docs';
}

const { title, description, section } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0f14" />
    <link rel="icon" href={url("favicon.svg")} type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400;1,500&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
  </head>

  <body>
    <header class="masthead t-ui">
      <a href={url("")} class="masthead__brand" aria-label="namesync home">
        <Logo size="var(--step-0)" />
      </a>
      <nav class="masthead__nav">
        <a href={url("docs/install")} aria-current={section === 'docs' ? 'page' : undefined}>docs</a>
        <a href="https://github.com/oddurs/herdr-namesync">source</a>
      </nav>
    </header>

    <slot />

    <footer class="colophon t-label">
      <div>namesync — names terminal workspaces from the agent’s own intent.</div>
      <div>Gotham palette by Andrew Wong. Set in IBM Plex Sans and IBM Plex Mono.</div>
    </footer>
  </body>
</html>

<style>
  .masthead__brand {
    text-decoration: none;
    display: inline-flex;
  }
</style>

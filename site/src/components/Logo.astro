---
/**
 * The namesync lockup.
 *
 * Mark: two staggered arrows, one out and one back — the ASCII `<-` `->` a
 * terminal person already reads as an exchange. The lower arrow carries the
 * accent because it is the one delivering the new name.
 *
 * Lockup: the mark's stroke is set to match the wordmark's stem weight at the
 * same size, and its optical centre is aligned to the wordmark's x-height
 * rather than to the type's bounding box. Those two things are most of why a
 * lockup reads as drawn rather than assembled.
 */

interface Props {
  /** Wordmark size. The mark scales from it, so the pair stays locked. */
  size?: string;
  /** Mark only, for the favicon and tight spaces. */
  markOnly?: boolean;
  class?: string;
}

const { size = 'var(--step-0)', markOnly = false, class: className } = Astro.props;
---

<span class:list={['lockup', className]} style={`--lockup-size:${size}`}>
  <svg class="lockup__mark" viewBox="0 0 26 20" role="img" aria-label="namesync">
    <g fill="none" stroke-width="2.9" stroke-linecap="round" stroke-linejoin="round">
      <g class="lockup__out">
        <path d="M23 6H5" />
        <path d="M9.5 1.5 5 6l4.5 4.5" />
      </g>
      <g class="lockup__in">
        <path d="M3 14h18" />
        <path d="M16.5 9.5 21 14l-4.5 4.5" />
      </g>
    </g>
  </svg>
  {!markOnly && <span class="lockup__word">namesync</span>}
</span>

<style>
  .lockup {
    display: inline-flex;
    align-items: center;
    /* Gap tracks the type size, so the lockup holds at any scale. */
    gap: 0.36em;
    font-size: var(--lockup-size);
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  .lockup__mark {
    /* Cap height, not em box: the mark then sits on the same optical line as
       the wordmark instead of floating above it. */
    height: 0.76em;
    width: auto;
    flex: none;
    overflow: visible;
    /* Nudge onto the x-height centre. */
    transform: translateY(0.012em);
  }

  .lockup__out {
    stroke: var(--fg-subtle);
    transition: stroke var(--dur-fast) var(--ease);
  }

  .lockup__in {
    stroke: var(--accent-text);
    transition: stroke var(--dur-fast) var(--ease);
  }

  .lockup__word {
    font-family: var(--font-sans);
    font-weight: var(--weight-semi);
    /* Plex Sans is drawn open for screen reading; closing it up is what turns
       the word into a mark rather than a word set in the UI face. */
    letter-spacing: -0.017em;
    color: var(--fg-strong);
  }

  .lockup:hover .lockup__out { stroke: var(--fg-muted); }
  .lockup:hover .lockup__in { stroke: var(--accent-hover); }
</style>
